{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "events",
    "GroupId": "dyn-ctc-ingest-group",
    "DiscoveryIntervalMs": 3000,
    "MaxPollIntervalMs": 10000,
    "SessionTimeoutMs": 6000,
    "HeartbeatIntervalMs": 2000,
    "RetryBackoffMs": 2000,
    "CommitTickMs": 750,
    "ProcessingDelayMinFactor": 0.5,
    "ProcessingDelayMaxFactor": 2.5,
    "StateDir": "./.state",
    "RedisConnectionString": "localhost:6379",
    "StubUrl": "http://localhost:5080",
    "StubLatencyMs": 1000,
    "Mode": "assign",
    "AutoOffsetReset": "earliest",
    "CrashAfterOffset": null
  }
}
